# When .npmignore exists, npm uses it INSTEAD of .gitignore
# This allows us to publish the dist folder even though it's in .gitignore

# Exclude source files (we only want the built dist/ folder)
/admin
/server
/types
/utils

# Exclude test files
/cypress
cypress.config.js
jest.config.js
*.test.ts
*.test.js
*.cy.jsx

# Exclude dev config
.editorconfig
.eslintignore
.eslintcache
.prettierignore
.prettierrc
.gitignore
.git
.vscode
.node-version
.tsbuildinfo
dependabot.yml

# Exclude dependencies
node_modules
yarn.lock

# Exclude logs
*.log
